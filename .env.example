# Copia este archivo a `.env` y ajusta los valores. Nunca subas `.env` al repositorio.
# NODE_ENV no se define aqui: lo asignan Next.js y los runners de test.

# URL publica de la aplicacion
APP_URL=http://localhost:3000

# PostgreSQL (docker compose levanta uno local con estas credenciales, puerto 5433)
DATABASE_URL=postgresql://cables:cables@localhost:5433/cables?schema=public
# Base de datos para tests de integracion y E2E
DATABASE_URL_TEST=postgresql://cables:cables@localhost:5433/cables_test?schema=public

# Email (local: Mailpit -> http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
# Solo en producción (Resend u otro SMTP). Mailpit no necesita credenciales.
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Buscador de Cables <no-reply@cables.local>"

# Better Auth. Genera el secreto con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Debe tener 32 caracteres o mas. No reutilices el de otros entornos.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# `pnpm db:seed` crea este administrador y, fuera de produccion y sobre una base vacia,
# datos de ejemplo inventados con la forma de los reales: ~4.500 cables L1-L4, ~500 bandejas
# y sus recorridos.
# Usuario administrador que crea el seed. Cambialo antes de desplegar: con NODE_ENV=production
# el seed se niega a crearlo con este correo o esta clave, que son publicos. Es tambien quien
# recibe el aviso de las cuentas nuevas pendientes de aprobar.
SEED_ADMIN_EMAIL=admin@cables.local
SEED_ADMIN_PASSWORD=CambiaEstaClave1!
SEED_ADMIN_NAME=Administrador
