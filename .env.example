# Copia este archivo a `.env` y ajusta los valores. Nunca subas `.env` al repositorio.
# NODE_ENV no se define aqui: lo asignan Next.js y los runners de test.

# URL publica de la aplicacion
APP_URL=http://localhost:3000

# PostgreSQL (docker compose levanta uno local con estas credenciales, puerto 5433)
DATABASE_URL=postgresql://cables:cables@localhost:5433/cables?schema=public
# Base de datos para tests de integracion y E2E
DATABASE_URL_TEST=postgresql://cables:cables@localhost:5433/cables_test?schema=public
# Conexiones que abre cada instancia de la app (por defecto 5). Desplegada sin servidor hay
# muchas instancias a la vez: deja 1-3 y apunta DATABASE_URL al pooler de la base (PgBouncer o
# el que dé el proveedor). Las migraciones (`pnpm db:deploy`) no pasan por
# el pooler: ejecútalas con DATABASE_URL apuntando a la conexión directa.
# DATABASE_POOL_MAX=5
# Producción: URL con la que se aplican las migraciones al desplegar (dueño de las tablas). Si
# no se define, se usa DATABASE_URL. Ver docs/DESPLIEGUE.md.
# DATABASE_URL_MIGRATE=

# Email (local: Mailpit -> http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
# Solo en producción (Resend u otro SMTP). Mailpit no necesita credenciales.
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Buscador de Cables <no-reply@cables.local>"

# Better Auth. Genera el secreto con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Debe tener 32 caracteres o mas. No reutilices el de otros entornos.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Cabeceras de las que se toma la IP del cliente para el límite de intentos (separadas por comas).
# Solo las que pone siempre el proxy de delante, sustituyendo lo que mande el cliente. En local,
# vacía (x-forwarded-for); en Vercel, x-real-ip.
AUTH_IP_HEADERS=

# Producción (Vercel Cron): secreto de 32 caracteres o más con el que Vercel llama cada día a
# /api/cron/cleanup. Genéralo como BETTER_AUTH_SECRET. Sin él, la limpieza no se ejecuta.
CRON_SECRET=

# `pnpm db:seed` crea este administrador y, fuera de produccion y sobre una base vacia,
# datos de ejemplo inventados con la forma de los reales: ~4.500 cables L1-L4, ~500 bandejas
# y sus recorridos.
# Usuario administrador que crea el seed. Cambialo antes de desplegar: con NODE_ENV=production
# el seed se niega a crearlo con este correo o esta clave, que son publicos. Es tambien quien
# recibe el aviso de las cuentas nuevas pendientes de aprobar.
SEED_ADMIN_EMAIL=admin@cables.local
SEED_ADMIN_PASSWORD=CambiaEstaClave1!
SEED_ADMIN_NAME=Administrador

# Teselas de los planos que dibuja `pnpm data:render` (datos del cliente: fuera de git).
# Ruta relativa a la raíz del repo o absoluta. La app solo las sirve con sesión.
DRAWINGS_DIR=private-data/drawings
# Producción: las teselas van en un bucket privado de Cloudflare R2 (API S3). `pnpm data:upload`
# las sube y la app las lee con estas claves; sin ellas, ambas usan DRAWINGS_DIR. Crea un token
# de R2 con permiso de lectura y escritura solo sobre ese bucket. Ver docs/DESPLIEGUE.md.
DRAWINGS_S3_ENDPOINT=
DRAWINGS_S3_BUCKET=
DRAWINGS_S3_ACCESS_KEY_ID=
DRAWINGS_S3_SECRET_ACCESS_KEY=

# Opcional. Desde esta fecha el historial y la "última acción" se muestran; lo anterior (la carga
# inicial de los listados) se guarda pero no se ve. Por defecto, 17/11/2026 00:00 (Madrid).
# HISTORY_START=2026-11-16T23:00:00Z
