# Copia este archivo a `.env` y ajusta los valores. Nunca subas `.env` al repositorio.
# NODE_ENV no se define aqui: lo asignan Next.js y los runners de test.

# URL publica de la aplicacion
APP_URL=http://localhost:3000

# PostgreSQL (docker compose levanta uno local con estas credenciales, puerto 5433)
DATABASE_URL=postgresql://cables:cables@localhost:5433/cables?schema=public
# Base de datos para tests de integracion y E2E
DATABASE_URL_TEST=postgresql://cables:cables@localhost:5433/cables_test?schema=public

# Email (local: Mailpit -> http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="Buscador de Cables <no-reply@cables.local>"
