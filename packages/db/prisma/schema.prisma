// Esquema de la base de datos.
// Modelos de autenticación (fase 1), cables y ubicaciones (fase 2), trazabilidad
// (fase 5) y bandejas y recorridos de los datos reales (fase 7).
// Ver docs/ARQUITECTURA.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Autenticación (Better Auth)
// ---------------------------------------------------------------------------

/// Un rol: qué puede hacer quien lo tiene (fase 12). Los cuatro de siempre tienen como id su
/// clave (`ADMIN`, `SUPERVISOR`, `TECHNICIAN`, `VIEWER`) y no se borran; el administrador crea
/// otros desde la web. `permissions` solo admite los permisos del código (`PERMISSIONS`).
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  /// El rol Administrador: no se edita ni se borra, y es el único con la gestión de cuentas y
  /// de roles.
  locked      Boolean  @default(false)
  /// Uno de los cuatro de siempre: no se borra (sí se editan sus permisos, salvo Administrador).
  system      Boolean  @default(false)
  /// Control de concurrencia: dos administradores editando a la vez no se pisan.
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@map("role")
}

/// Permiso extra de una persona, además de los de su rol (fase 12).
model UserPermissionGrant {
  userId      String
  user        User     @relation("UserGrants", fields: [userId], references: [id], onDelete: Cascade)
  permission  String
  grantedById String
  grantedBy   User     @relation("UserGrantsGiven", fields: [grantedById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@id([userId, permission])
  @@map("user_permission_grant")
}

model User {
  id                   String                @id @default(cuid())
  name                 String
  email                String                @unique
  emailVerified        Boolean               @default(false)
  image                String?
  /// Id del rol (`Role.id`). Los de siempre: "ADMIN", "SUPERVISOR", "TECHNICIAN", "VIEWER".
  role                 String                @default("VIEWER")
  roleInfo             Role                  @relation(fields: [role], references: [id], onDelete: Restrict)
  /// Permisos además de los de su rol.
  permissionGrants     UserPermissionGrant[] @relation("UserGrants")
  grantsGiven          UserPermissionGrant[] @relation("UserGrantsGiven")
  active               Boolean               @default(true)
  /// Cuándo aprobó un administrador la cuenta. Null: registrada y pendiente de aprobación.
  approvedAt           DateTime?
  /// Última vez que abrió «Pendientes de revisar»: el menú y el inicio solo avisan de lo nuevo.
  discrepanciesSeenAt  DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  sessions             Session[]
  accounts             Account[]
  // Trazabilidad (fase 5): qué hizo cada usuario sobre los cables.
  cableEvents          CableEvent[]
  lastActionCables     Cable[]               @relation("CableLastActionBy")
  installedCables      Cable[]               @relation("CableInstalledBy")
  connectedCables      Cable[]               @relation("CableConnectedBy")
  // Auditoría de cuentas (fase 10): lo que hizo cada administrador y a quién.
  userEventsDone       UserEvent[]           @relation("UserEventActor")
  userEvents           UserEvent[]           @relation("UserEventTarget")
  // Excel diario (fase 14): lo que subió y lo que decidió cada uno.
  excelImports         ExcelImport[]
  decidedDiscrepancies CableDiscrepancy[]    @relation("DiscrepancyDecidedBy")
  // Guardados (fase 16): sus carpetas.
  savedFolders         SavedFolder[]

  @@map("user")
}

enum UserEventAction {
  CREATED
  APPROVED
  ROLE_CHANGED
  DEACTIVATED
  REACTIVATED
  PERMISSIONS_CHANGED // permisos extra de una persona
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_DELETED
  NAME_CHANGED // alguien se cambió su propio nombre (`details`: de y a)
}

/// Auditoría de las cuentas: quién creó, aprobó, cambió de rol o desactivó a quién. Nunca se
/// edita ni se borra desde la app.
model UserEvent {
  id        String          @id @default(cuid())
  action    UserEventAction
  actorId   String
  actor     User            @relation("UserEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  /// La persona afectada; vacío en los cambios de un rol (`ROLE_*`).
  targetId  String?
  target    User?           @relation("UserEventTarget", fields: [targetId], references: [id], onDelete: Restrict)
  /// Rol antes y después (`ROLE_CHANGED`) o con el que entra (`CREATED`, `APPROVED`): ids.
  fromRole  String?
  toRole    String?
  /// El rol de un cambio `ROLE_*` (su id; puede estar ya borrado: el nombre va en `details`).
  roleId    String?
  /// Lo que cambió, legible: nombre del rol, permisos añadidos y quitados.
  details   Json?
  createdAt DateTime        @default(now())

  @@index([createdAt])
  @@index([targetId, createdAt])
  @@index([action, createdAt])
  @@map("user_event")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Contadores del rate limiting de Better Auth. En base de datos (y no en memoria)
// para que el límite se comparta entre todas las instancias serverless.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ---------------------------------------------------------------------------
// Ubicaciones y catálogos (fase 2)
// ---------------------------------------------------------------------------

enum LocationType {
  PLANT // central / planta
  AREA // área
  UNIT // unidad, p. ej. "Reactor X"
  SITE // sitio, p. ej. "Sitio XZ"
}

/// Árbol Planta → Área → Unidad → Sitio. `path` es materializado ("/PLANTA/AREA-1/R-X")
/// para filtrar un subárbol con un prefijo.
model Location {
  id        String       @id @default(cuid())
  name      String
  code      String       @unique
  type      LocationType
  parentId  String?
  parent    Location?    @relation("LocationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Location[]   @relation("LocationTree")
  path      String       @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  trays      Tray[]
  cablesFrom Cable[]      @relation("CableOrigin")
  cablesTo   Cable[]      @relation("CableDestination")
  cablesAt   Cable[]      @relation("CableCurrent")
  eventsFrom CableEvent[] @relation("EventFromLocation")
  eventsTo   CableEvent[] @relation("EventToLocation")

  @@index([parentId])
  @@map("location")
}

/// Tipo de cable del proyecto: "0,6/1 KV 8X2.5 MM2 CU", "JE-Y(St)Y 4 x 2 x 0,8mm"...
model CableType {
  id        String   @id @default(cuid())
  name      String   @unique
  /// Código del tipo en el listado eléctrico ("C0802"). Los de instrumentación no tienen.
  code      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cables    Cable[]

  @@map("cable_type")
}

model Color {
  id        String   @id @default(cuid())
  name      String   @unique
  hex       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cables    Cable[]

  @@map("color")
}

model Manufacturer {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cables    Cable[]

  @@map("manufacturer")
}

/// Empresa que tendió el cable (fase 14): la trae el Excel diario y se edita en Catálogos.
model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cables    Cable[]

  @@map("company")
}

// ---------------------------------------------------------------------------
// Cables y trazabilidad (fases 3 a 5)
// ---------------------------------------------------------------------------

enum InstallationStatus {
  UNVERIFIED // sin revisar: no sale en ningún Excel y nadie ha comprobado aún cómo está
  NOT_LAID // no tendido (fase 14: sustituye a «en almacén» y «enrollado»)
  PARTIALLY_LAID // tendido a medias: una punta espera en una bandeja
  LAID // tendido
  RETIRED // retirado
}

enum ConnectionStatus {
  DISCONNECTED
  ORIGIN_ONLY
  DESTINATION_ONLY
  CONNECTED
}

/// Timbrado: prueba de continuidad / identificación de los conductores del cable.
enum TestStatus {
  NOT_TESTED
  TESTED_OK
  TESTED_FAILED
}

enum CableAction {
  CREATED
  UPDATED
  LAID
  PARTIALLY_LAID
  COILED // ya no se registra (fase 14); queda en eventos antiguos
  CONNECTED
  DISCONNECTED
  MOVED // ya no se registra (fase 14); queda en eventos antiguos
  RETIRED
  CORRECTION
  TESTED // timbrado
  DELETED // baja lógica (deletedAt)
  WIRING_EDITED // bornas corregidas en campo (modo editar del conexionado)
  EXCEL_UPDATED // lo cambió el Excel del día (fase 14)
  EXCEL_REVIEWED // una persona decidió una discrepancia con el Excel (fase 14)
}

/// Nivel del cable en los listados del proyecto (ver docs/DATOS-PROYECTO.md).
enum CableLevel {
  L1 // instrumentación (< 60 V)
  L2 // baja tensión, fuerza y control
  L3 // baja tensión, unipolares
  L4 // media tensión
}

/// Un extremo del cable.
enum CableEndSide {
  ORIGIN
  DESTINATION
}

model Cable {
  id               String        @id @default(cuid())
  /// Normalizado con `normalizeCableCode`: "SH-50", "99XAT10W2005".
  code             String        @unique
  /// Servicio: para qué sirve el cable.
  description      String?
  level            CableLevel?
  /// Número de marcado alternativo ("99 CBLC-0001").
  altCode          String?
  /// Revisión del cable en su listado ("3", "2_RX00").
  revision         String?
  /// Circuitos con varios cables en paralelo: "1 de 2".
  circuit          String?
  cablesPerCircuit Int?
  /// "CONTROL", "3PH+N+PE", "DC"...
  composition      String?
  /// Esquema donde aparece (listado de instrumentación).
  diagram          String?
  /// La longitud del listado está pendiente de confirmar.
  lengthPending    Boolean       @default(false)
  /// Documento y página de donde se cargó, para ir al PDF a comprobar.
  sourceDocument   String?
  sourcePage       Int?
  typeId           String?
  type             CableType?    @relation(fields: [typeId], references: [id], onDelete: Restrict)
  colorId          String?
  color            Color?        @relation(fields: [colorId], references: [id], onDelete: Restrict)
  manufacturerId   String?
  manufacturer     Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  conductors       Int?
  crossSectionMm2  Decimal?      @db.Decimal(8, 2)
  outerDiameterMm  Decimal?      @db.Decimal(8, 2)
  lengthM          Decimal?      @db.Decimal(10, 2)
  voltageRating    String?

  // Lo que trae el Excel diario (fase 14).
  /// Fecha real de tendido según el Excel.
  laidOn             DateTime? @db.Date
  companyId          String?
  company            Company?  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// Bobina de la que salió (la real), la que se pidió usar (la estimada) y su estado
  /// ("En Sitio"…), tal como los escribe el Excel.
  reel               String?
  plannedReel        String?
  reelStatus         String?
  /// Metros reales de este cable (un tramo del circuito) y del circuito entero, y en cuántos
  /// tramos se reparte (solo el Excel eléctrico).
  actualLengthM      Decimal?  @db.Decimal(10, 2)
  actualLengthTotalM Decimal?  @db.Decimal(10, 2)
  actualSections     Int?
  originId           String?
  origin             Location? @relation("CableOrigin", fields: [originId], references: [id], onDelete: Restrict)
  destinationId      String?
  destination        Location? @relation("CableDestination", fields: [destinationId], references: [id], onDelete: Restrict)

  // Extremos tal y como vienen en los listados. `originId`/`destinationId` apuntan a la sala
  // o al edificio; aquí va el equipo exacto.
  originEquipment            String?
  /// Celda o cubículo del cuadro (listado eléctrico).
  originCubicle              String?
  /// Prensaestopas (listado de instrumentación).
  originGland                String?
  originFunctionKks          String?
  originInstallationKks      String?
  /// Sala tal y como viene en el listado ("99UXB16RA001").
  originRoom                 String?
  destinationEquipment       String?
  destinationCubicle         String?
  destinationGland           String?
  destinationFunctionKks     String?
  destinationInstallationKks String?
  destinationRoom            String?

  /// Recorrido previsto, en orden.
  routeSteps     CableRouteStep[]
  /// Conexionado: hilos con su regletero y borna en cada punta, y puentes (listados eléctricos).
  wires          CableWire[]
  jumpers        CableJumper[]
  /// Revisión de la tabla de conexionado ("R." junto a INTERCONNECTION, listado eléctrico).
  wiringRevision String?
  /// Cable tendido a medias: qué punta quedó suelta y en qué bandeja espera.
  looseEnd       CableEndSide?
  looseEndTrayId String?
  looseEndTray   Tray?            @relation("CableLooseEndTray", fields: [looseEndTrayId], references: [id], onDelete: Restrict)

  /// Dónde estaba físicamente un cable enrollado o en almacén. Sin uso desde la fase 14: se
  /// conserva el dato, pero nada lo escribe ni lo muestra.
  currentLocationId  String?
  currentLocation    Location?          @relation("CableCurrent", fields: [currentLocationId], references: [id], onDelete: Restrict)
  installationStatus InstallationStatus @default(NOT_LAID)
  connectionStatus   ConnectionStatus   @default(DISCONNECTED)
  testStatus         TestStatus         @default(NOT_TESTED)

  // Columnas resumen (desnormalizadas) para la tabla del buscador. Se actualizan
  // en la misma transacción que crea el CableEvent.
  lastAction       CableAction?
  lastActionById   String?
  lastActionBy     User?            @relation("CableLastActionBy", fields: [lastActionById], references: [id], onDelete: Restrict)
  lastActionAt     DateTime?
  /// Quién escribió la última acción: la de la carga del proyecto no se muestra (fase 14).
  lastActionSource CableEventSource @default(APP)
  installedById    String?
  installedBy      User?            @relation("CableInstalledBy", fields: [installedById], references: [id], onDelete: Restrict)
  installedAt      DateTime?
  connectedById    String?
  connectedBy      User?            @relation("CableConnectedBy", fields: [connectedById], references: [id], onDelete: Restrict)
  connectedAt      DateTime?

  notes           String?
  /// Lo creó el Excel del día: no está en los listados del proyecto (sin recorrido ni
  /// conexionado). Lleva la etiqueta «Solo datos del Excel».
  excelOnly       Boolean            @default(false)
  /// Control de concurrencia y sincronización offline.
  version         Int                @default(1)
  /// Baja lógica: los cables nunca se borran.
  deletedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  events          CableEvent[]
  excelImportRows ExcelImportRow[]
  discrepancies   CableDiscrepancy[]

  @@index([installationStatus, connectionStatus])
  @@index([originId])
  @@index([destinationId])
  @@index([currentLocationId])
  @@index([typeId])
  @@index([colorId])
  @@index([manufacturerId])
  @@index([companyId])
  @@index([lastActionById, lastActionAt])
  @@index([level])
  @@index([looseEndTrayId])
  // Búsqueda tolerante a errores por código (fase 4).
  @@index([code(ops: raw("gin_trgm_ops"))], type: Gin, map: "cable_code_trgm_idx")
  // Búsqueda por equipo ("todos los cables del cuadro X"), por subcadena.
  @@index([originEquipment(ops: raw("gin_trgm_ops"))], type: Gin, map: "cable_origin_equipment_trgm_idx")
  @@index([destinationEquipment(ops: raw("gin_trgm_ops"))], type: Gin, map: "cable_destination_equipment_trgm_idx")
  @@map("cable")
}

// ---------------------------------------------------------------------------
// Bandejas y recorridos (fase 7)
// ---------------------------------------------------------------------------

/// Tipo de tramo según la letra de su código (ver docs/DATOS-PROYECTO.md).
enum TrayKind {
  LADDER // L: bandeja de escalera
  GRID // W: bandeja de rejilla
  SPECIAL // S: bandeja especial
  CONDUIT // C: tubo
  DUCT // D: canalización enterrada
  OTHER // otra letra
}

/// Bandeja, tubo o canalización por la que pasan los cables.
model Tray {
  id             String    @id @default(cuid())
  /// "99UXA00L22036".
  code           String    @unique
  kind           TrayKind
  /// Nivel de tensión de los cables que lleva (1-4), según el código.
  voltageLevel   Int?
  /// Cota de la bandeja dentro de su nivel de tensión (0-3), según el código.
  elevationLevel Int?
  /// Área o edificio del código ("99UXA").
  areaCode       String?
  /// Edificio en el árbol de ubicaciones, si existe.
  locationId     String?
  location       Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  /// Tamaño, cuando el plano lo da: "L600100300" → ancho 600, ala 100, radio 300.
  widthMm        Int?
  flangeHeightMm Int?
  bendRadiusMm   Int?
  /// Tubos y canalizaciones: "C025" → 25 mm.
  diameterMm     Int?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  drawings       TrayDrawing[]
  routeSteps     CableRouteStep[]
  looseEndCables Cable[]          @relation("CableLooseEndTray")

  @@index([areaCode])
  @@index([locationId])
  @@index([code(ops: raw("gin_trgm_ops"))], type: Gin, map: "tray_code_trgm_idx")
  @@map("tray")
}

/// Hoja de plano donde aparece una bandeja.
model TrayDrawing {
  id           String        @id @default(cuid())
  trayId       String
  tray         Tray          @relation(fields: [trayId], references: [id], onDelete: Restrict)
  /// Número del plano.
  drawing      String
  /// Hoja dentro del plano ("04").
  sheet        String
  /// Área y cotas o planta que muestra la hoja.
  title        String?
  /// Página del PDF de planos.
  sourcePage   Int?
  /// Dónde está la bandeja en la hoja, en fracción de la hoja desde la esquina superior
  /// izquierda: [{ x, y, kind }] con kind "label" (su código dibujado), "flag" (la bandera de
  /// su sección) o "table" (su fila en una tabla).
  marks        Json          @default("[]")
  sheetId      String?
  drawingSheet DrawingSheet? @relation(fields: [sheetId], references: [id], onDelete: SetNull)

  @@unique([trayId, drawing, sheet])
  @@index([sheetId])
  @@map("tray_drawing")
}

/// Hoja de los planos de recorrido. Su imagen son teselas (`<imageKey>.dzi`) que dibuja
/// `pnpm data:render` en el almacén de planos, fuera de git.
model DrawingSheet {
  id          String        @id @default(cuid())
  drawing     String
  sheet       String
  title       String?
  /// Página del PDF de planos.
  sourcePage  Int
  /// Tamaño de la hoja en puntos: da la proporción para colocar las marcas.
  width       Int
  height      Int
  imageKey    String        @unique
  /// Cambia cuando cambia el texto de la hoja (otra revisión).
  fingerprint String
  updatedAt   DateTime      @updatedAt
  trays       TrayDrawing[]

  @@unique([drawing, sheet])
  @@map("drawing_sheet")
}

/// Tramo del recorrido en los listados de instrumentación.
enum RouteSection {
  FIELD // FIELD_TRAY: bandejas de campo
  ROOM // ROOM_TRAY: bandejas de la sala
}

/// Paso del recorrido previsto de un cable. Si el paso no es una bandeja conocida
/// ("CONTIGUOUS PANEL", "TRAM. VERTICAL"), `trayId` es null y queda el texto.
model CableRouteStep {
  id       String        @id @default(cuid())
  cableId  String
  cable    Cable         @relation(fields: [cableId], references: [id], onDelete: Restrict)
  /// 1, 2, 3... en el orden del listado.
  position Int
  /// Texto tal y como viene en el listado.
  label    String
  trayId   String?
  tray     Tray?         @relation(fields: [trayId], references: [id], onDelete: Restrict)
  section  RouteSection?

  @@unique([cableId, position])
  @@index([trayId])
  @@map("cable_route_step")
}

/// De dónde sale un evento del historial. La carga de los listados lo usa para no pisar lo
/// que una persona corrigió a mano en la app.
/// Un hilo del cable (tabla INTERCONNECTION del listado) y dónde va en cada punta.
/// Los campos `pdf*` guardan lo que dice el listado; los otros, lo que hay en campo. Son iguales
/// hasta que alguien corrige una borna con el modo editar; una recarga de los listados
/// actualiza los `pdf*` y solo cambia los de campo que nadie ha corregido.
model CableWire {
  id                  String  @id @default(cuid())
  cableId             String
  cable               Cable   @relation(fields: [cableId], references: [id], onDelete: Restrict)
  /// 1, 2, 3... en el orden del listado.
  position            Int
  /// Número o código del hilo tal y como viene: "1+", "BN", "BK-3", "SH".
  wire                String
  /// Color del hilo (listado de instrumentación): "1.Blue".
  colour              String?
  /// Regletero o bloque, y borna o punto, en origen y en destino ("X51" · "11").
  originBlock         String?
  originPoint         String?
  destinationBlock    String?
  destinationPoint    String?
  pdfOriginBlock      String?
  pdfOriginPoint      String?
  pdfDestinationBlock String?
  pdfDestinationPoint String?

  @@unique([cableId, position])
  @@map("cable_wire")
}

/// Puente entre dos bornas (tabla JUMPERS del listado eléctrico). Solo lectura.
model CableJumper {
  id        String  @id @default(cuid())
  cableId   String
  cable     Cable   @relation(fields: [cableId], references: [id], onDelete: Restrict)
  position  Int
  code      String
  fromBlock String?
  fromPoint String?
  toBlock   String?
  toPoint   String?

  @@unique([cableId, position])
  @@map("cable_jumper")
}

enum CableEventSource {
  APP // una persona, desde la aplicación
  PROJECT_LOAD // la carga del proyecto: los listados (`pnpm data:load`) y el primer Excel
  EXCEL // el Excel del día, subido desde la web (fase 14)
}

/// Registro INMUTABLE de lo que hace cada usuario sobre un cable. Nunca se edita
/// ni se borra: los errores se corrigen con un evento CORRECTION.
model CableEvent {
  id              String             @id @default(cuid())
  cableId         String
  cable           Cable              @relation(fields: [cableId], references: [id], onDelete: Restrict)
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  action          CableAction
  fromLocationId  String?
  fromLocation    Location?          @relation("EventFromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocationId    String?
  toLocation      Location?          @relation("EventToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)
  /// { campo: { from, to } }
  changes         Json
  notes           String?
  correctsEventId String?
  correctsEvent   CableEvent?        @relation("EventCorrection", fields: [correctsEventId], references: [id], onDelete: Restrict)
  corrections     CableEvent[]       @relation("EventCorrection")
  /// Quién escribió el evento: una persona en la app o la carga de los listados.
  source          CableEventSource   @default(APP)
  /// El Excel que lo escribió: su fecha y quién lo subió («Según el Excel del dd/mm»).
  excelImportId   String?
  excelImport     ExcelImport?       @relation(fields: [excelImportId], references: [id], onDelete: Restrict)
  /// Discrepancias: la de la persona que contradice el Excel y la que la decide.
  discrepancies   CableDiscrepancy[] @relation("DiscrepancyWebEvent")
  decisions       CableDiscrepancy[] @relation("DiscrepancyDecisionEvent")
  /// Hora real en campo (acciones hechas sin conexión).
  clientCreatedAt DateTime?
  createdAt       DateTime           @default(now())

  @@index([cableId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([excelImportId])
  @@map("cable_event")
}

// ---------------------------------------------------------------------------
// Excel diario de estado (fase 14)
// ---------------------------------------------------------------------------

/// Los dos Excel del proyecto. `EXCEL_KINDS` de `@cables/shared` lista los mismos.
enum ExcelKind {
  ELECTRICAL
  INSTRUMENTATION
}

enum ExcelImportStatus {
  UPLOADING // llegan las filas por partes: todavía no se puede aplicar
  PREVIEW // vista previa guardada: no se ha aplicado nada
  APPLYING // aplicándose por lotes
  APPLIED
  DISCARDED // descartada o sustituida por otro Excel
}

/// Qué hace una fila de la vista previa.
enum ExcelRowKind {
  CHANGE // cambia datos de un cable que ya existe
  NEW // el cable no está en la web: se crea
  DISCREPANCY // una persona marcó en la web algo que el Excel contradice
}

enum DiscrepancyStatus {
  OPEN // pendiente de revisar: el cable conserva lo de la web
  KEPT_WEB // se mantuvo lo de la web
  ACCEPTED_EXCEL // se aceptó lo del Excel
}

/// Un Excel subido: su vista previa y, al aplicarlo, lo que cambió. Nunca se borra.
model ExcelImport {
  id                     String             @id @default(cuid())
  kind                   ExcelKind
  /// Fecha del Excel (la del nombre del archivo, editable al subirlo).
  excelDate              DateTime           @db.Date
  fileName               String
  /// La primera carga: sus eventos no se ven y no hay discrepancias.
  projectLoad            Boolean            @default(false)
  status                 ExcelImportStatus  @default(PREVIEW)
  uploadedById           String
  uploadedBy             User               @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  /// Filas con cable que leyó el navegador y cuántas han llegado (se envían por partes), y las
  /// que no se usan con su motivo.
  rowCount               Int
  receivedCount          Int                @default(0)
  /// [{ row, code, reason }]
  ignored                Json
  /// Discrepancias abiertas con las que este Excel ya coincide: se avisa al aplicarlo.
  agreeingDiscrepancyIds String[]
  createdAt              DateTime           @default(now())
  appliedAt              DateTime?
  discardedAt            DateTime?
  /// Bobinas que trae el Excel (fase 18), validadas al subirlo: sustituyen a las de su tipo
  /// al aplicarlo. Null si el Excel no tiene sus hojas: las de antes se quedan.
  reels                  Json?
  /// Tiradas de las bobinas que trae su hoja, contadas por el navegador: deben llegar todas.
  /// Null si el Excel no tiene esa hoja: las de antes se quedan.
  reelPullCount          Int?
  rows                   ExcelImportRow[]
  events                 CableEvent[]
  discrepancies          CableDiscrepancy[]
  reelsApplied           Reel[]
  reelPulls              ReelPull[]

  @@index([kind, status])
  @@index([status, excelDate])
  @@map("excel_import")
}

/// Una bobina de los Excel del día (fase 18): las hojas «Seguimientos Bobina cable» y
/// «DrumsR01». Las escribe solo el Excel al aplicarse; nadie las edita en la web. Sus cables se
/// buscan al consultar, por la bobina real y la estimada de cada cable.
model Reel {
  id           String      @id @default(cuid())
  kind         ExcelKind
  /// Cómo se distingue de las otras de su tipo (`reelKey`): el número de almacén en el
  /// eléctrico; el drum y el número en instrumentación.
  key          String
  /// Nombre de fábrica («Drum Identification»).
  drum         String?
  /// Número de almacén, el que lleva escrito la bobina.
  tag          String?
  /// Código de las tablas de ingeniería, si la lista de almacén lo trae.
  code         String?
  /// «Nro Solicitud»: el nombre de la bobina en obra.
  request      String?
  description  String?
  voltage      String?
  pickedUpOn   DateTime?   @db.Date
  receivedM    Decimal?    @db.Decimal(12, 2)
  usedM        Decimal?    @db.Decimal(12, 2)
  /// Puede ser negativo: el Excel dice que se usó más de lo recibido.
  remainingM   Decimal?    @db.Decimal(12, 2)
  pulls        Int?
  pendingPulls Int?
  /// Metros que piden las tiradas pendientes.
  pendingM     Decimal?    @db.Decimal(12, 2)
  otherM       Decimal?    @db.Decimal(12, 2)
  deliveredOn  DateTime?   @db.Date
  deliveredM   Decimal?    @db.Decimal(12, 2)
  /// En la hoja de seguimiento; si no, solo en la lista de almacén, sin sus cifras.
  tracked      Boolean
  /// Veces que la nombra la lista de almacén (varias bobinas con un solo nombre).
  pieces       Int?
  /// El Excel que la escribió por última vez.
  importId     String
  import       ExcelImport @relation(fields: [importId], references: [id], onDelete: Restrict)
  excelDate    DateTime    @db.Date
  updatedAt    DateTime    @updatedAt

  @@unique([kind, key])
  @@index([tag])
  @@index([drum])
  @@map("reel")
}

/// Una tirada de una bobina (fase 18): una fila de la hoja de tiradas del Excel («Bobina-Tag»
/// en el eléctrico, un conductor por fila; «Table» en instrumentación). Llegan al subir el Excel y
/// cuentan desde que se aplica: entonces se borran las de los Excel anteriores de su tipo.
model ReelPull {
  id        String      @id @default(cuid())
  importId  String
  import    ExcelImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  kind      ExcelKind
  /// Fila de la hoja, para ordenar como el Excel.
  row       Int
  /// Código del cable tal como lo escribe el Excel (el del circuito en el eléctrico).
  code      String
  /// Conductor del eléctrico («…T3C2»: tramo 3, conductor 2) y su tramo.
  conductor String?
  circuit   Int?
  /// La bobina: número de almacén y drum.
  tag       String?
  drum      String?
  /// Marcas de metros de la bobina al empezar y al acabar, y lo tirado.
  startM    Decimal?    @db.Decimal(12, 2)
  endM      Decimal?    @db.Decimal(12, 2)
  pulledM   Decimal?    @db.Decimal(12, 2)
  pulledOn  DateTime?   @db.Date

  @@index([importId])
  @@index([kind, tag])
  @@index([code])
  @@map("reel_pull")
}

/// Una fila de la vista previa: un cable que el Excel cambia, crea o contradice.
model ExcelImportRow {
  id        String       @id @default(cuid())
  importId  String
  import    ExcelImport  @relation(fields: [importId], references: [id], onDelete: Restrict)
  code      String
  /// Null: el cable es nuevo.
  cableId   String?
  cable     Cable?       @relation(fields: [cableId], references: [id], onDelete: Restrict)
  kind      ExcelRowKind
  /// Lo que dice el Excel (`ExcelStatusRow`).
  data      Json
  /// Lo que se aplicará: { campo: { from, to } }.
  changes   Json
  /// Discrepancia: { web, excel, webEventId, webAt, discrepancyId }.
  conflict  Json?
  /// Las filas desmarcadas no se aplican y vuelven con el siguiente Excel.
  selected  Boolean      @default(true)
  appliedAt DateTime?

  @@unique([importId, code])
  @@index([importId, kind])
  @@index([importId, selected, appliedAt])
  @@map("excel_import_row")
}

/// Una persona marcó en la web algo que un Excel posterior contradice. Queda en «Pendientes de
/// revisar» hasta que alguien decide; mientras, el cable conserva lo de la web.
model CableDiscrepancy {
  id              String            @id @default(cuid())
  cableId         String
  cable           Cable             @relation(fields: [cableId], references: [id], onDelete: Restrict)
  /// El Excel que la abrió y el último que la contradice.
  importId        String
  import          ExcelImport       @relation(fields: [importId], references: [id], onDelete: Restrict)
  excelDate       DateTime          @db.Date
  /// El estado de la web y el del Excel: { installationStatus, connectionStatus }.
  web             Json
  excel           Json
  /// El evento de la persona que marcó lo de la web.
  webEventId      String
  webEvent        CableEvent        @relation("DiscrepancyWebEvent", fields: [webEventId], references: [id], onDelete: Restrict)
  /// Fecha de un Excel posterior que ya coincide con la web: solo se avisa, nunca se cierra sola.
  agreesOn        DateTime?         @db.Date
  status          DiscrepancyStatus @default(OPEN)
  decidedById     String?
  decidedBy       User?             @relation("DiscrepancyDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt       DateTime?
  decisionEventId String?
  decisionEvent   CableEvent?       @relation("DiscrepancyDecisionEvent", fields: [decisionEventId], references: [id], onDelete: Restrict)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([cableId, status])
  @@map("cable_discrepancy")
}

// ---------------------------------------------------------------------------
// Guardados (fase 16)
// ---------------------------------------------------------------------------

enum SavedKind {
  CABLE
  TRAY
  EQUIPMENT
}

/// Una carpeta de guardados de una persona (un solo nivel). Nadie más la ve.
model SavedFolder {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  items     SavedItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userId, name])
  @@map("saved_folder")
}

/// Algo guardado en una carpeta. `key`: el id del cable, el código de la bandeja o el código
/// del equipo (los equipos no tienen tabla: son el texto del listado). Una misma cosa puede
/// estar en varias carpetas, pero una sola vez en cada una.
model SavedItem {
  id        String      @id @default(cuid())
  folderId  String
  folder    SavedFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  kind      SavedKind
  key       String
  createdAt DateTime    @default(now())

  @@unique([folderId, kind, key])
  @@index([kind, key])
  @@map("saved_item")
}
