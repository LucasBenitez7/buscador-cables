{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "DATABASE_URL_TEST",
    "DATABASE_POOL_MAX",
    "APP_URL",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_USER",
    "SMTP_PASSWORD",
    "EMAIL_FROM",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "SEED_ADMIN_EMAIL",
    "SEED_ADMIN_PASSWORD",
    "SEED_ADMIN_NAME",
    "DRAWINGS_DIR",
    "DRAWINGS_S3_ENDPOINT",
    "DRAWINGS_S3_BUCKET",
    "DRAWINGS_S3_ACCESS_KEY_ID",
    "DRAWINGS_S3_SECRET_ACCESS_KEY"
  ],
  "tasks": {
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "^generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^generate"]
    },
    "typecheck": {
      "dependsOn": ["^generate"]
    },
    "test": {
      "dependsOn": ["^generate", "^test"],
      "outputs": ["coverage/**"]
    },
    "@cables/shared#test": {
      "dependsOn": ["^generate", "^test"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/**"],
      "outputs": ["coverage/**"]
    },
    "@cables/data#test": {
      "dependsOn": ["^generate", "^test", "@cables/web#test"],
      "outputs": ["coverage/**"]
    }
  }
}
